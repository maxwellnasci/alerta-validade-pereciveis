# Exemplo: copie para .env local e preencha com valores do SEU ambiente.
# Nunca use chaves de acesso AWS aqui; use um perfil AWS CLI/credenciais temporárias.
AWS_REGION=sa-east-1
BUCKET_NAME=seu-bucket-de-dados
REMETENTE_EMAIL=remetente@example.invalid
DESTINATARIO_EMAIL=destinatario@example.invalid
